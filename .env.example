# Copy to `.env` and adjust values for local development or CI builds.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the client bundle.

# Base URL for API requests (optional; defaults to FPL public API).
EXPO_PUBLIC_API_URL=https://fantasy.premierleague.com/api

# Shake-to-inspect network logger (react-native-network-logger).
# - Automatically ON when running in development (`__DEV__`).
# - Set to "true" for Staging / QA internal preview builds.
# - MUST remain "false" (or unset) for production App Store / Play Store releases.
EXPO_PUBLIC_ENABLE_NETWORK_LOGGER=false

# Expo push notifications — set after running `eas init` or from Expo dashboard.
# EXPO_PUBLIC_EAS_PROJECT_ID=
